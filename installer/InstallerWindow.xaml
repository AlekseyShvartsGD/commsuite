<Window x:Class="CommsuiteInstaller.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commsuite Setup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66808080"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Topmost="True">

    <!-- The whole screen is a grey wash at 60% transparency (the desktop shows
         through). The dialog on top of it is a solid grey panel with square
         corners - no rounding, no border. -->
    <Border x:Name="Root"
            Background="#FF333333"
            CornerRadius="0"
            Width="480" Height="340"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock Text="Commsuite Setup" Style="{StaticResource TitleText}" DockPanel.Dock="Left" />
                <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="0,0,0,2"
                           HorizontalAlignment="Right" />
            </DockPanel>

            <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="Commsuite will be installed to the folder below. You can change it." />

            <DockPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}"
                           FontWeight="SemiBold" Margin="0,0,0,7" Text="Install folder" />
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…"
                        Style="{StaticResource DarkButton}" Width="88" Margin="10,0,0,0"
                        Click="Browse_Click" VerticalAlignment="Center" />
                <TextBox x:Name="FolderBox" Style="{StaticResource DarkTextBox}" />
            </DockPanel>

            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <ProgressBar x:Name="Progress" Style="{StaticResource DarkProgress}" Value="0" />
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}"
                           Margin="0,9,0,0" Text="Ready to install."
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="6" Margin="0,20,0,0">
                <CheckBox x:Name="LaunchBox" Style="{StaticResource DarkCheck}"
                          Content="Launch Commsuite" IsChecked="True"
                          Visibility="Collapsed" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DarkButton}"
                            Width="92" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button x:Name="MainButton" Content="Install" Style="{StaticResource AccentButton}"
                            Width="104" Click="MainButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
