<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Role=Uninstall builds the small uninstaller that ships inside the setup
         exe; the default Role=Setup build embeds the payload and that
         uninstaller. See build.ps1. -->
    <Role Condition="'$(Role)' == ''">Setup</Role>
    <AssemblyName Condition="'$(Role)' == 'Setup'">CommsuiteSetup</AssemblyName>
    <AssemblyName Condition="'$(Role)' == 'Uninstall'">CommsuiteUninstall</AssemblyName>
    <RootNamespace>CommsuiteInstaller</RootNamespace>
    <!-- Role=Uninstall defines UNINSTALLER so the standalone Uninstall.exe runs
         the uninstall flow by default (double-clicking passes no /uninstall). -->
    <DefineConstants Condition="'$(Role)' == 'Uninstall'">$(DefineConstants);UNINSTALLER</DefineConstants>
    <!-- -p:NoElevate=true swaps in an asInvoker manifest so the install
         logic can be smoke-tested without a UAC prompt. -->
    <ApplicationManifest Condition="'$(NoElevate)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(NoElevate)' == 'true'">app.asInvoker.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(Role)' == 'Setup'">app_icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Keep the exe's ProductVersion clean ("1.0.37"), not "1.0.37+<git sha>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.0.39</Version>
    <AssemblyVersion>1.0.38.0</AssemblyVersion>
    <FileVersion>1.0.38.0</FileVersion>
    <Product>Commsuite</Product>
    <Company>Commsuite</Company>
    <Copyright>Commsuite</Copyright>
    <Description>Commsuite setup</Description>
    <AssemblyTitle>Commsuite Setup</AssemblyTitle>
    <DebugType Condition="'$(Role)' == 'Setup'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- The setup exe carries both the app payload and the standalone
       uninstaller, so a single download installs and later uninstalls
       without anything else on disk. -->
  <ItemGroup Condition="'$(Role)' == 'Setup' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)">
      <LogicalName>Commsuite.Payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(Role)' == 'Setup' And Exists('$(UninstallerPath)')">
    <EmbeddedResource Include="$(UninstallerPath)">
      <LogicalName>Commsuite.Uninstaller.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
